# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_stack
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# LiteLLM Proxy Settings
LITELLM_MASTER_KEY=sk-master-key-123
LITELLM_SALT_KEY=sk-salt-key-456

# ChatGPT via LiteLLM native OAuth
# First request will trigger LiteLLM device-code login in the container logs.

# OpenHands Config
WORKSPACE_BASE=/home/syahril/Desktop/dev/openclaw_coding/workspace
LLM_MODEL=chatgpt/gpt-5.4
GITHUB_TOKEN=your_github_personal_access_token

# OpenClaw Bot Config
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# SECURITY: Put your Telegram User ID here (e.g. 12345678) to restrict access
ALLOWED_USER_IDS=your_telegram_id_here
DISCORD_BOT_TOKEN=your_discord_bot_token
SLACK_BOT_TOKEN=your_slack_bot_token
