# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_stack
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# API Keys (For Fallback/Direct API)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Workspace Config
WORKSPACE_BASE=./workspace

# OpenClaw Bot Config
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ALLOWED_USER_IDS=your_telegram_id
DISCORD_BOT_TOKEN=your_discord_bot_token
SLACK_BOT_TOKEN=your_slack_bot_token

# Pi Coding Agent (Embedded)
AC_PI_CODING_AGENT_ENABLED=true

# Active Model (Uncomment one after pairing)
AC_PI_CODING_AGENT_MODEL=chatgpt:default
# AC_PI_CODING_AGENT_MODEL=gemini:default
# AC_PI_CODING_AGENT_MODEL=kimi:default

# Fallback Model (If primary hits limit)
AC_PI_CODING_AGENT_FALLBACK_MODEL=gemini:gemini-1.5-pro

AC_PI_CODING_AGENT_SANDBOX_IMAGE=ghcr.io/mariozechner/pi-coding-agent-sandbox:latest
